  "patterns": [
    {
      "id": "LAYOUT-DECISION",
      "role": "decision",
      "design_principle": "Lead with a falsifiable recommendation, strongest counteroption and the explicit board decision; no imitation of trademarked layouts.",
      "source_ids": [
        "SRC-STR-MCK",
        "SRC-STR-CONS"
      ],
      "requires_evidence": true
    },
    {
      "id": "LAYOUT-OPTIONS",
      "role": "options",
      "design_principle": "Compare genuinely distinct choices on common qualitative criteria; unknown evidence must remain visible.",
      "source_ids": [
        "SRC-STR-MBCG",
        "SRC-STR-BUS"
      ],
      "requires_evidence": true
    },
    {
      "id": "LAYOUT-CAPABILITIES",
      "role": "capability",
      "design_principle": "Show capability group, verified gap, business consequence and priority; no fabricated maturity colors.",
      "source_ids": [
        "SRC-STR-MBCG",
        "SRC-ORIA-T1"
      ],
      "requires_evidence": true
    },
    {
      "id": "LAYOUT-ARCHITECTURE",
      "role": "architecture",
      "design_principle": "Two-level view: executive projection + formal model identifier, with legible dependencies and traceable semantics.",
      "source_ids": [
        "SRC-STR-BUS",
        "SRC-STR-CONS"
      ],
      "requires_evidence": true
    },
    {
      "id": "LAYOUT-ROADMAP",
      "role": "roadmap",
      "design_principle": "Render dependencies and continue/adjust/stop gates rather than a decorative calendar.",
      "source_ids": [
        "SRC-STR-MCK",
        "SRC-ORIA-21"
      ],
      "requires_evidence": true
    },
    {
      "id": "LAYOUT-KPI",
      "role": "kpi",
      "design_principle": "Separate observed baseline from management aspiration and measured outcome; never imply target attainment.",
      "source_ids": [
        "SRC-STR-MBCG",
        "SRC-ORIA-XLS"
      ],
      "requires_evidence": true
    }
  ],
  "implementation_boundary": "These are independently authored principles linked at repository/method level, NOT verified page-by-page visual observations or execution of external skill instructions. External candidates are not imported. Visual style benchmark against official BCG/McKinsey/Accenture publications is a separate NOT_RUN task."
}
