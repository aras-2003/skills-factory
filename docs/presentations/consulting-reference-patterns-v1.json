  "patterns": [
    {
      "id": "LAYOUT-DECISION",
      "role": "decision",
      "design_principle": "Lead with a falsifiable recommendation, strongest counteroption and the explicit board decision; no imitation of trademarked layouts.",
      "source_ids": [
        "SRC-STR-MCK",
        "SRC-STR-CONS",
        "OFF-BCG-01"
      ],
      "requires_evidence": true
    },
    {
      "id": "LAYOUT-OPTIONS",
      "role": "options",
      "design_principle": "Compare genuinely distinct choices on common qualitative criteria; unknown evidence must remain visible.",
      "source_ids": [
        "SRC-STR-MBCG",
        "SRC-STR-BUS",
        "OFF-MCK-03"
      ],
      "requires_evidence": true
    },
    {
      "id": "LAYOUT-CAPABILITIES",
      "role": "capability",
      "design_principle": "Show capability group, verified gap, business consequence and priority; no fabricated maturity colors.",
      "source_ids": [
        "SRC-STR-MBCG",
        "SRC-ORIA-T1",
        "OFF-BCG-03"
      ],
      "requires_evidence": true
    },
    {
      "id": "LAYOUT-ARCHITECTURE",
      "role": "architecture",
      "design_principle": "Two-level view: executive projection + formal model identifier, with legible dependencies and traceable semantics.",
      "source_ids": [
        "SRC-STR-BUS",
        "SRC-STR-CONS",
        "OFF-MCK-02"
      ],
      "requires_evidence": true
    },
    {
      "id": "LAYOUT-ROADMAP",
      "role": "roadmap",
      "design_principle": "Render dependencies and continue/adjust/stop gates rather than a decorative calendar.",
      "source_ids": [
        "SRC-STR-MCK",
        "SRC-ORIA-21",
        "OFF-BCG-02"
      ],
      "requires_evidence": true
    },
    {
      "id": "LAYOUT-KPI",
      "role": "kpi",
      "design_principle": "Separate observed baseline from management aspiration and measured outcome; never imply target attainment.",
      "source_ids": [
        "SRC-STR-MBCG",
        "SRC-ORIA-XLS",
        "OFF-ACN-01"
      ],
      "requires_evidence": true
    },
    {
      "id": "LAYOUT-GOVERNANCE",
      "role": "governance",
      "design_principle": "Expose decision owner, advisor, executor, escalation and decision latency; avoid unverified RACI.",
      "source_ids": [
        "OFF-BCG-01",
        "OFF-MCK-03"
      ],
      "requires_evidence": true
    },
    {
      "id": "LAYOUT-RISKS",
      "role": "risks",
      "design_principle": "One risk per row with cause, consequence, mitigation, decision gate and evidence status, no invented likelihood scores.",
      "source_ids": [
        "OFF-BCG-02",
        "OFF-ACN-02"
      ],
      "requires_evidence": true
    },
    {
      "id": "LAYOUT-VALUE",
      "role": "value",
      "design_principle": "Separate hypothesized value drivers, costs, observed baseline and realization proof with explicit benefit confidence.",
      "source_ids": [
        "OFF-BCG-03",
        "OFF-ACN-01"
      ],
      "requires_evidence": true
    },
    {
      "id": "LAYOUT-HANDOFF",
      "role": "handoff",
      "design_principle": "Show stable object IDs crossing strategy, architecture and delivery layers; surface unknown mappings.",
      "source_ids": [
        "OFF-MCK-01",
        "OFF-MCK-02"
      ],
      "requires_evidence": true
    }
  ],
  "implementation_boundary": "Nine official public pages were text-reviewed for editorial principles, not independently visually scored or cleared for reproduction. Audited community skill sources are not official firm materials and are reference-only unless permitted. A mapping is not evidence of original skill runtime execution.",
