{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aras-2003/skills-factory/blob/main/workflows/presentation-production/references/canonical-deck-v1.schema.json",
  "title": "Skills Factory Canonical Deck v1",
  "type": "object",
  "required": ["schema_version", "deck_id", "slides"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "deck_id": { "type": "string", "minLength": 1 },
    "communicated_thesis": { "type": "string" },
    "source_pack_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "source_decision_status": { "type": ["string", "null"] },
    "governing_question": { "type": "string" },
    "structure_choice": { "type": "string" },
    "why_choice": { "type": "string" },
    "audience_objections": { "type": "array", "items": { "type": "string" } },
    "upstream_challenges": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "creative_direction": { "type": "object", "additionalProperties": true },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/Source" } },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/SlideSpec" }
    },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false,
  "$defs": {
    "Source": {
      "type": "object",
      "required": ["source_id"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "source_locator": { "type": "string" },
        "source_as_of": { "type": ["string", "null"] },
        "retrieval_at": { "type": ["string", "null"] },
        "license_rights": { "type": ["string", "null"] },
        "confidentiality": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "required": ["claim_id"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string" },
        "epistemic_status": {
          "enum": ["USER_PROVIDED", "EXTERNAL_VERIFIED", "CANONICAL", "DERIVED", "HYPOTHESIS", "UNKNOWN", "CONTRADICTED"]
        },
        "source_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "data_fields": { "type": "array", "items": { "type": "string" } },
        "units": { "type": ["string", "null"] },
        "denominator": { "type": ["string", "null"] },
        "source_as_of": { "type": ["string", "null"] },
        "derivation": { "type": ["string", "null"] },
        "uncertainty": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "DataReference": {
      "type": "object",
      "required": ["data_ref_id"],
      "properties": {
        "data_ref_id": { "type": "string", "minLength": 1 },
        "value": { "type": ["number", "string", "null"] },
        "unit": { "type": ["string", "null"] },
        "source_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "as_of": { "type": ["string", "null"] },
        "denominator": { "type": ["string", "null"] },
        "comparison_basis": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "source_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "source_finding_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "source_option_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "source_pack_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "as_of": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "Layout": {
      "type": "object",
      "required": ["layout_id", "tokens"],
      "properties": {
        "layout_id": { "type": "string", "minLength": 1 },
        "tokens": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      },
      "additionalProperties": false
    },
    "ExhibitSpec": {
      "type": "object",
      "required": ["exhibit_id", "visual_type", "supported_data"],
      "properties": {
        "exhibit_id": { "type": "string", "minLength": 1 },
        "slide_id": { "type": "string", "minLength": 1 },
        "visual_job": { "type": "string" },
        "visual_type": { "type": "string", "minLength": 1 },
        "supported_data": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "provenance": { "$ref": "#/$defs/Provenance" },
        "units": { "type": ["string", "null"] },
        "as_of": { "type": ["string", "null"] },
        "uncertainty": { "type": ["string", "null"] },
        "annotations": { "type": "array", "items": { "type": "string" } },
        "deterministic_renderer": { "type": ["string", "null"] },
        "asset_id": { "type": ["string", "null"] },
        "alternative_text": { "type": ["string", "null"] },
        "editability": { "enum": ["EDITABLE_NATIVE", "EDITABLE_PARTIAL", "RASTER_ASSET", "FLATTENED", "UNKNOWN"] },
        "capability_status": { "enum": ["AVAILABLE", "UNAVAILABLE", "UNKNOWN"] },
        "execution_status": { "enum": ["NOT_ATTEMPTED", "BLOCKED_NO_RENDERER", "PAYLOAD_RENDERED", "FAIL_RENDERER_INVOCATION"] },
        "extensions": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "SlideSpec": {
      "type": "object",
      "required": ["slide_id", "role", "action_title", "claims", "data_refs", "exhibits", "layout", "notes", "provenance", "desired_editability"],
      "properties": {
        "slide_id": { "type": "string", "minLength": 1 },
        "section": { "type": "string" },
        "role": { "type": "string", "minLength": 1 },
        "action_title": { "type": "string", "minLength": 1 },
        "body": { "type": "string" },
        "claims": { "type": "array", "items": { "$ref": "#/$defs/Claim" } },
        "data_refs": { "type": "array", "items": { "$ref": "#/$defs/DataReference" } },
        "exhibits": { "type": "array", "items": { "$ref": "#/$defs/ExhibitSpec" } },
        "layout": { "$ref": "#/$defs/Layout" },
        "notes": { "type": "string" },
        "provenance": { "$ref": "#/$defs/Provenance" },
        "desired_editability": { "enum": ["NATIVE_REQUIRED", "PREFERRED", "NOT_REQUIRED", "UNKNOWN"] },
        "reader_question": { "type": "string" },
        "transition": { "type": "string" },
        "visual_role": { "type": "string" },
        "proof_required": { "type": "array", "items": { "type": "string" } },
        "source_line": { "type": "string" },
        "alternative_text": { "type": "string" },
        "output_state": { "type": ["string", "object"] },
        "extensions": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    }
  }
}
