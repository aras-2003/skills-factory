{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skills-factory:evaluation-report:v1",
  "title": "Skills Factory Evaluation Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evaluation_id", "skill_id", "candidate_version", "source_sha",
    "runtime", "evaluation_profile", "evalset", "comparator", "evaluated_at",
    "evidence_receipts", "strengths", "strengths_empty_reason", "weaknesses", "weaknesses_empty_reason", "reasoning", "assertions", "cases",
    "score", "comparison_delta", "decision"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "skill_id": {"type": "string", "minLength": 1},
    "candidate_version": {"type": "string", "minLength": 1},
    "source_sha": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "evaluation_profile": {"$ref": "#/$defs/profile"},
    "evalset": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "comparator": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "source_sha", "score", "profile_id", "profile_version", "evalset_id", "evalset_version", "case_ids", "assertion_ids", "runtime_identity", "not_applicable_reason"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "source_sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$"},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
        "profile_id": {"type": ["string", "null"]},
        "profile_version": {"type": ["string", "null"]},
        "evalset_id": {"type": ["string", "null"]},
        "evalset_version": {"type": ["string", "null"]},
        "case_ids": {"type": ["array", "null"], "items": {"type": "string"}, "uniqueItems": true},
        "assertion_ids": {"type": ["array", "null"], "items": {"type": "string"}, "uniqueItems": true},
        "runtime_identity": {"anyOf": [{"$ref": "#/$defs/runtime"}, {"type": "null"}]},
        "not_applicable_reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"id": {"type": "string"}}, "required": ["id"]}, "then": {"properties": {"version": {"type": "string"}, "source_sha": {"type": "string"}, "score": {"type": "number"}, "profile_id": {"type": "string"}, "profile_version": {"type": "string"}, "evalset_id": {"type": "string"}, "evalset_version": {"type": "string"}, "case_ids": {"type": "array", "minItems": 1}, "assertion_ids": {"type": "array", "minItems": 1}, "runtime_identity": {"type": "object"}, "not_applicable_reason": {"type": "null"}}}},
        {"if": {"properties": {"id": {"type": "null"}}, "required": ["id"]}, "then": {"properties": {"version": {"type": "null"}, "source_sha": {"type": "null"}, "score": {"type": "null"}, "profile_id": {"type": "null"}, "profile_version": {"type": "null"}, "evalset_id": {"type": "null"}, "evalset_version": {"type": "null"}, "case_ids": {"type": "null"}, "assertion_ids": {"type": "null"}, "runtime_identity": {"type": "null"}, "not_applicable_reason": {"type": "string", "minLength": 1}}}}
      ]
    },
    "evaluated_at": {"type": "string", "format": "date-time"},
    "evidence_receipts": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "strengths": {"type": "array", "items": {"$ref": "#/$defs/strength"}},
    "strengths_empty_reason": {"type": ["string", "null"]},
    "weaknesses": {"type": "array", "items": {"$ref": "#/$defs/weakness"}},
    "weaknesses_empty_reason": {"type": ["string", "null"]},
    "reasoning": {"type": "string", "minLength": 1, "description": "Concise decision rationale with evidence and uncertainty; never hidden chain-of-thought."},
    "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
    "score": {"$ref": "#/$defs/score"},
    "comparison_delta": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "reason"],
      "properties": {
        "value": {"type": ["number", "null"], "minimum": -10, "maximum": 10},
        "reason": {"type": ["string", "null"]}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "blocking_gates", "next_actions"],
      "properties": {
        "status": {"enum": ["PASS", "ITERATE", "REJECT"]},
        "blocking_gates": {"type": "array", "items": {"type": "string"}},
        "next_actions": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model_id", "tool_identity"],
      "properties": {
        "provider": {"type": ["string", "null"]},
        "model_id": {"type": ["string", "null"]},
        "tool_identity": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {"ref": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "version", "calibration_status", "dimensions", "excluded_dimensions", "thresholds"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "calibration_status": {"enum": ["PROPOSED", "VALIDATED"]},
        "dimensions": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "additionalProperties": false, "required": ["name", "weight", "critical"], "properties": {"name": {"type": "string", "minLength": 1}, "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}, "critical": {"type": "boolean"}}}
        },
        "excluded_dimensions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "reason"], "properties": {"name": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}}},
        "thresholds": {"type": "object", "additionalProperties": false, "required": ["pass_minimum", "critical_dimension_minimum", "reject_below"], "properties": {"pass_minimum": {"type": "number", "minimum": 0, "maximum": 10}, "critical_dimension_minimum": {"type": "number", "minimum": 0, "maximum": 10}, "reject_below": {"type": "number", "minimum": 0, "maximum": 10}}}
      }
    },
    "strength": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension", "claim", "case_ids", "evidence_refs", "impact"],
      "properties": {"dimension": {"type": "string", "minLength": 1}, "claim": {"type": "string", "minLength": 1}, "case_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "impact": {"type": "string", "minLength": 1}, "delta_vs_comparator": {"type": ["number", "null"], "minimum": -10, "maximum": 10}}
    },
    "weakness": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension", "finding", "case_ids", "evidence_refs", "severity", "cause_status"],
      "properties": {"dimension": {"type": "string", "minLength": 1}, "finding": {"type": "string", "minLength": 1}, "case_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "severity": {"enum": ["critical", "high", "medium", "low"]}, "cause_status": {"enum": ["observed", "hypothesis", "unknown"]}, "remediation": {"type": "string"}}
    },
    "assertion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "case_id", "dimension", "required", "importance", "execution_state", "grade", "evidence_refs", "blocking_gate"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "case_id": {"type": "string", "minLength": 1}, "dimension": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}, "importance": {"enum": [1, 2, 4]},
        "execution_state": {"enum": ["executed", "blocked", "not_executed"]},
        "grade": {"type": ["number", "null"], "enum": [0, 0.5, 1, null]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "blocking_gate": {"type": "boolean"}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "execution_state", "execution_reason", "outcome", "evaluation_status", "compatibility_status"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "execution_state": {"enum": ["executed", "blocked", "awaiting_runner", "no_steps", "not_executed"]},
        "execution_reason": {"type": ["string", "null"]},
        "outcome": {"type": ["string", "null"], "enum": ["passed", "failed", null]},
        "evaluation_status": {"enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "NOT_RUN"]},
        "compatibility_status": {"enum": ["COMPATIBLE", "INCOMPATIBLE", "UNKNOWN", "NOT_APPLICABLE"]}
      }
    },
    "score": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unrounded_value", "scale", "status", "profile", "dimensions", "calculation_version", "coverage", "missing_evidence"],
      "properties": {
        "value": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
        "unrounded_value": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
        "scale": {"const": "0-10"},
        "status": {"enum": ["FINAL", "PROVISIONAL", "NOT_SCORABLE"]},
        "profile": {"type": "string", "minLength": 1},
        "dimensions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "weight", "value", "required_assertions", "executed_assertions", "case_count", "evidence_refs"], "properties": {"name": {"type": "string", "minLength": 1}, "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}, "value": {"type": ["number", "null"], "minimum": 0, "maximum": 10}, "required_assertions": {"type": "integer", "minimum": 0}, "executed_assertions": {"type": "integer", "minimum": 0}, "case_count": {"type": "integer", "minimum": 0}, "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}}},
        "calculation_version": {"const": "weighted-assertions-v1"},
        "coverage": {"type": "object", "additionalProperties": false, "required": ["required_assertions", "executed_assertions", "ratio"], "properties": {"required_assertions": {"type": "integer", "minimum": 0}, "executed_assertions": {"type": "integer", "minimum": 0}, "ratio": {"type": "number", "minimum": 0, "maximum": 1}}},
        "missing_evidence": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
