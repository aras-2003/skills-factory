{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "skills-factory-runtime": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "${PLUGIN_ROOT}/mcp/server.py"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  }
}
